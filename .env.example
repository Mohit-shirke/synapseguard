# Copy to .env and adjust. Never commit .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# For FalkorDB Cloud, set these (left empty for local Docker):
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
SG_GRAPH=sg_otel_demo
SG_QUERY_TIMEOUT_MS=2000
SG_READONLY_ROW_LIMIT=200
# If set, mutating API endpoints require header X-API-Key with this value.
SG_API_KEY=
# Optional local LLM narration (template narrative is used when off or on any failure).
SG_LLM=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# MCP: allow the record_root_cause_feedback tool (off by default).
SG_MCP_ALLOW_FEEDBACK=0
